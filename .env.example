# --- Did I Lock? — environment variables ---
# Copy to .env for local use (the server loads .env automatically at boot — real
# environment variables always win), or paste into your host's dashboard (Render/Railway/etc).
# EVERYTHING here is optional — the app runs with friendly demo fallbacks without them.
# EXCEPTION: sending email (verification / password reset) requires BOTH BASE_URL and
# RESEND_API_KEY — links are always built from BASE_URL, never from request headers.

# Server
PORT=3000
DIL_DATA_DIR=./data                # where the SQLite db + VAPID keys live (mount a disk here in prod)
JWT_SECRET=change-me-to-a-long-random-string

# Real Google OAuth (sign-in with Google)
# Google Cloud Console → APIs & Services → OAuth client (Web application)
# Authorized redirect URI: https://your-domain/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Real SMS for OTP (otherwise the 6-digit code is shown in-app as a demo SMS card)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                       # e.g. +1xxxxxxxxxx or an alphanumeric sender ID

# Push notifications: VAPID keys AUTO-GENERATE into DIL_DATA_DIR on first boot
# (.vapid.json) — you normally don't need to set anything.
DIL_SEED_DEMO=   # set to 1 ONLY on personal/demo installs — seeds the demo account and enables in-app OTP display
BASE_URL=   # optional: pin the OAuth origin behind proxies
RESEND_API_KEY=   # free tier resend.com key — enables verification + account emails
MAIL_FROM=        # e.g. "Did I Lock? <hello@yourdomain>" (must match a verified Resend sender)
DIL_SMS_CCS=91    # comma-separated country codes allowed for SMS OTP (SMS-pumping defence; default India-only)
